# Personal settings for one Jarvis install. Run bin/setup to answer these and write .env (never committed).
# npm start and the login service from bin/install-service load .env. Every value has a neutral default in code.

# Who Jarvis works for, as their email sign-off writes it. A last line that is only this name is cut from email drafts.
JARVIS_OWNER_NAME="Owner Name"
# The owner's company and one line on what it does, for the email triage prompt.
JARVIS_COMPANY="Example Co"
JARVIS_COMPANY_ABOUT="a software company that serves car dealers"

# The Gmail account the gws CLI reads, and every address of the owner (comma separated), so reply all skips them.
JARVIS_GMAIL_ACCOUNT="owner@example.test"
JARVIS_OWNER_EMAILS="owner@example.test"
# Set to off to run without the Gmail watcher.
JARVIS_GMAIL="on"

# Phone access over Tailscale: the tailnet login allowed in, the app's tailnet URL, and the phone's tailnet addresses
# (the only devices the Shell pane accepts). The socket and launchd label are those of a userspace tailscaled, if you run one.
JARVIS_ALLOWED_LOGINS="owner@example.test"
JARVIS_TERM_ORIGIN="https://jarvis-host.example-tailnet.ts.net:7717"
JARVIS_SHELL_DEVICES="100.64.0.10,fd7a:115c:a1e0::10"
JARVIS_TS_SOCKET=""
JARVIS_TS_SERVICE="local.tailscale-personal"

# Web push contact (mailto:). The keys are created in data/ on first start when these are empty.
JARVIS_VAPID_SUBJECT="mailto:owner@example.test"

# Your own GitHub repositories (owner/name, comma separated), for bin/trust-own-repos.py.
JARVIS_TRUSTED_REPOS="example-org/acmeapp_nextjs,example-org/FB-marketplace-uploader"
# Local clones the named actions and bin/pr-audit use.
JARVIS_FBM_REPO=""
JARVIS_PR_AUDIT_REPO=""

# The product's MCP servers and the support desk's ticket prefix (TICKET-1045).
JARVIS_PROD_MCP_URL="https://app.example.test/api/mcp"
JARVIS_STAGING_MCP_URL="https://staging.app.example.test/api/mcp"
JARVIS_TICKET_PREFIX="TICKET"

# The one Google Sheet bin/sheet-edit may write to.
JARVIS_MIGRATION_SHEET_ID="EXAMPLE_SHEET_ID"

# Optional: JARVIS_PORT (7717), JARVIS_HOME_WORKTREE, JARVIS_TTS_FR, JARVIS_TTS_EN, JARVIS_WAKE_WORD. See README.md.
