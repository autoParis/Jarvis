SKIP_IN_DIFF = [":(exclude)pnpm-lock.yaml", ":(exclude)messages/index.ts"]

# Body sections that carry the worker's own grading. They go to the compare session only.
SEALED_HEADING = re.compile(
    r"merge verdict|residual|not proven|known limit|^risk\b|review|finisher|ready|\bgaps?\b|next steps",
    re.I,
)
# Lines outside those sections that still state a grade.
SEALED_LINE = re.compile(
    r"\bREADY\b|\bMERGE:|\bREVIEW:|\binsignificant\b|\bsignificant:|not proven|residual risk|\bfinisher\b", re.I
)
READY_MARK = re.compile(r"<!-- finisher: ready ([0-9a-f]{40}) -->")
READY_TITLE = re.compile(r"^## (?:✅ )?READY(?:: (MERGE|REVIEW))?(?: on `([0-9a-f]+)`)?", re.M)
RISK_ROW = re.compile(r"\|\s*Risk\s*\|\s*\*{0,2}(\w+)")

RUBRIC = """\
Classes, as this team defines them:
- significant: data loss or overwrite, client-visible wrong data (price, listing, report), money,
  access, messages to real people.
- insignificant: everything else, such as visual breakage, a false alarm, or a failure that is the
  same as today.
An intended behaviour change is not a gap. A gap a throwaway drive could close should have been
driven: say so. MERGE means no significant gap is open. REVIEW asks for a person and says why.
"""

