#!/bin/bash
# The brain's only way into Orca. Adds Jarvis's Run and identity, and allows only
# read commands plus the automatic-tier mutations (reply, steer, worker-release).
# Everything else goes through jarvis-act (needs the owner's yes).
set -euo pipefail
: "${JARVIS_RUN:?}" "${JARVIS_HANDLE:?}"
cmd="${1:-}"; shift || true
# POSTs {id, answer} to jarvisd. Prints jarvisd's error and fails when it refuses or is down.
jarvisd() {
  node -e 'const [u, p, id, answer] = process.argv.slice(1);
    fetch(u + p, { method: "POST", body: JSON.stringify({ id, answer }) })
      .then(async r => { const t = await r.text(); if (t && !r.ok) console.error(t); process.exit(r.ok ? 0 : 1); },
            e => { console.error(`jarvisd unreachable: ${e.cause?.code ?? e}`); process.exit(1); })' \
    "${JARVIS_URL:-http://127.0.0.1:7717}" "$@"
}
case "$cmd" in
  task-list|dispatch-show) exec orca orchestration "$cmd" --run "$JARVIS_RUN" --from "$JARVIS_HANDLE" "$@" --json ;;
  worker-list)             exec orca orchestration worker-list --run "$JARVIS_RUN" "$@" --json ;;
  run-show)                exec orca orchestration run-show --id "$JARVIS_RUN" "$@" --json ;;
  worker-show|worker-read|request-show) exec orca orchestration "$cmd" "$@" --json ;;
  peek)                    exec orca orchestration check --run "$JARVIS_RUN" --terminal "$JARVIS_HANDLE" --peek "$@" --json ;;
  worker-release)          exec orca orchestration worker-release "$@" --json ;;
  # Other Orca conversations and workspaces, read-only.
  search)        exec orca search "$@" --json ;;                    # search "<words>" [--since <iso>] [--sort newest]
  session)       exec "$(dirname "$0")/jarvis-session" "$@" ;;     # session <source.filePath> [--last N]
  worktrees)     exec orca worktree ps "$@" --json ;;
  terminals)     exec orca terminal list "$@" --json ;;
  terminal-read) exec orca terminal read "$@" --json ;;             # terminal-read --terminal <handle> [--limit N]
  inbox)  # inbox [--limit N] [--terminal <handle>]: messages across the owner's own Runs, heartbeats dropped
    orca orchestration inbox "$@" --json | node -e '
      let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
        const j = JSON.parse(s);
        if (!j.ok) { console.log(s); process.exit(1); }
        const keep = ({ id, run_id, type, from_handle, to_handle, subject, body, payload, read, created_at }) =>
          ({ id, run_id, type, from_handle, to_handle, subject, body, payload, read, created_at });
        console.log(JSON.stringify(j.result.messages.filter(m => m.type !== "heartbeat").map(keep), null, 1));
      });' ;;
  steer)  # steer --dispatch <id> --body "<the owner's instruction>"
    d=""; b=""
    while [ $# -gt 0 ]; do case "$1" in --dispatch) d="$2"; shift 2;; --body) b="$2"; shift 2;; *) shift;; esac; done
    [ -n "$d" ] && [ -n "$b" ] || { echo "usage: jarvis-orca steer --dispatch <id> --body <text>" >&2; exit 2; }
    out=$(orca orchestration send --run "$JARVIS_RUN" --from "$JARVIS_HANDLE" --to "dispatch:$d" --subject "From the owner" --body "$b" --json) || true
    echo "$out"
    echo "$out" | grep -q '"ok": *true' || exit 1
    # This closes any open escalation from that worker; jarvisd marks its card answered and records who said it.
    jarvisd /api/internal/steered "$d" "$b" || true ;;
  reply)  # reply --id <message id> --body "<answer>"; refuses a second reply to the same ask
    a=("$@"); id=""; body=""
    while [ $# -gt 0 ]; do case "$1" in --id) id="$2"; shift 2;; --body) body="$2"; shift 2;; *) shift;; esac; done
    [ -n "$id" ] || { echo "usage: jarvis-orca reply --id <message id> --body <text>" >&2; exit 2; }
    # Claim the ask in jarvisd first: a retried or repeated reply stops here instead of reaching the worker twice.
    jarvisd /api/internal/reply-claim "$id" || exit 1
    out=$(orca orchestration reply --run "$JARVIS_RUN" --from "$JARVIS_HANDLE" "${a[@]}" --json) || true
    echo "$out"
    if echo "$out" | grep -q '"ok": *true'; then
      jarvisd /api/internal/answered "$id" "$body" || echo "jarvis-orca: the reply went out but jarvisd did not record it. Do not send it again." >&2
    elif echo "$out" | grep -q '"ok": *false'; then
      jarvisd /api/internal/reply-release "$id" || true  # Orca refused it, so the ask is open again
      exit 1
    else
      echo "jarvis-orca: Orca gave no answer, so the reply may or may not have gone out. The ask stays marked replying; check it with request-show." >&2
      exit 1
    fi ;;
  *) echo "jarvis-orca: '$cmd' is not allowed. Read commands: task-list worker-list worker-show worker-read run-show dispatch-show request-show peek search session worktrees terminals terminal-read inbox. Automatic: reply, steer, worker-release. Starting, stopping or abandoning workers, and typing into a terminal (terminal-send), goes through jarvis-act." >&2; exit 2 ;;
esac
